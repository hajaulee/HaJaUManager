<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/packageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/list_item_icon_description"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_android_red_24dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="2"
                android:text="@string/sample_text"
                android:textColor="@color/espresso_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/latestVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:maxLines="1"
                android:text="@string/sample_text"
                android:textColor="@color/espresso_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/installedVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:maxLines="1"
                android:text="@string/sample_text"
                android:textColor="@color/espresso_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/removeButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_button_pill"
            android:contentDescription="@string/action_uninstall"
            android:minWidth="96dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/action_uninstall"
            android:textAllCaps="false"
            android:textColor="@color/espresso_text_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/downloadButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_pill"
            android:minWidth="108dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/action_install"
            android:textAllCaps="false"
            android:textColor="@color/espresso_text_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
