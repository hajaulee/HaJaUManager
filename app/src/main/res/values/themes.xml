<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HaJaUManager" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/espresso_accent</item>
        <item name="colorPrimaryVariant">@color/espresso_background</item>
        <item name="colorOnPrimary">@color/espresso_text_on_accent</item>
        <item name="colorSecondary">@color/espresso_accent</item>
        <item name="colorSecondaryVariant">@color/espresso_accent_focused</item>
        <item name="colorOnSecondary">@color/espresso_text_on_accent</item>
        <item name="android:statusBarColor">@color/espresso_background</item>
        <item name="android:navigationBarColor">@color/espresso_background</item>
        <item name="android:windowBackground">@color/espresso_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.HaJaUManager.NoActionBar" parent="Theme.HaJaUManager">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HaJaUManager.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/espresso_accent</item>
        <item name="colorPrimaryVariant">@color/espresso_background</item>
        <item name="colorOnPrimary">@color/espresso_text_on_accent</item>
        <item name="colorSecondary">@color/espresso_accent</item>
        <item name="colorSecondaryVariant">@color/espresso_accent_focused</item>
        <item name="colorOnSecondary">@color/espresso_text_on_accent</item>
        <item name="android:statusBarColor">@color/espresso_background</item>
        <item name="android:navigationBarColor">@color/espresso_background</item>
        <item name="android:windowBackground">@color/espresso_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.HaJaUManager.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.HaJaUManager.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>